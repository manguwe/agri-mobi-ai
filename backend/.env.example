# Loaded with: uvicorn app.main:app --env-file .env   (python-dotenv is included in uvicorn[standard])
# Comma-separated browser origins allowed to call the API. localhost:5173/4173 and Capacitor are always allowed.
# Add your deployed site, e.g. https://agrimobi.example.com. Use * only for open public APIs.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional regex for LAN phone testing, e.g. https?://192\.168\.\d+\.\d+:(5173|4173)
ALLOWED_ORIGIN_REGEX=
# Optional: folder containing knowledgeBase.json + diagnosisRules.json (default: backend/app/data, then frontend/src/data)
AGRIMOBI_DATA_DIR=

# Not used yet: the API does not write to Supabase (the app syncs history directly with RLS).
# Never put the service-role key anywhere in the frontend or Android app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
