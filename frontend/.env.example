# FastAPI diagnosis API is optional; the app can diagnose locally while offline.
VITE_USE_REMOTE_API=false
VITE_API_BASE_URL=http://localhost:8000
# Seconds a weak connection may take before the app gives up on the API and uses its local engine (milliseconds):
VITE_API_TIMEOUT_MS=8000

# Supabase browser/mobile client. Use the project's anon/publishable key only.
# Never put a service_role key in this file or in the frontend bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
